function [msg] = sendNotification(asset,data, entradas_2smm, entradas_2mmvix,vix);

today=length(data);

if entradas_2smm(end) == today 
msg = asset+ ":---2smm---:"+data(today)+":"+date;

elseif entradas_2mmvix(end) == today 
msg = asset+ ":-2smm+VIX-:"+data(today)+":"+date;

else
    msg = asset+ ":-NoSignal-:"+data(today)+":"+vix+date;

end

%incluir el vix